# Backend origin only, no /api suffix. Read by the API proxy on both hosts:
# api/proxy.ts on Vercel, worker/index.ts on Cloudflare.
#
# On Vercel it is a project environment variable; on Cloudflare it is set with
# `wrangler secret put KOLEARN_API_ORIGIN`, or put in a gitignored `.dev.vars`
# for `npm run cf:dev`.
KOLEARN_API_ORIGIN=https://kolearn-server.example.com

# Serve the admin API from the in-repo MSW handlers instead of a real backend.
# Off by default: kolearn-server implements /admin now, and running against the
# real thing is what catches drift. Set to 1 to work without a backend.
# VITE_MOCK_API=1
