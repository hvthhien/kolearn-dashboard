# Backend origin only, no /api suffix. Used by api/proxy.ts on Vercel.
KOLEARN_API_ORIGIN=https://kolearn-server.example.com

# Serve the admin API from the in-repo MSW handlers instead of a real backend.
# The server has no /admin/* endpoints yet; see README, "The contract is
# authored here". Set to 1 for local development until it does.
VITE_MOCK_API=1
